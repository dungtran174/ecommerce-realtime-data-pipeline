# =============================================================================
# Database Configuration (PostgreSQL OLTP)
# =============================================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432

# =============================================================================
# Airflow Configuration
# =============================================================================
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
_AIRFLOW_WWW_USER_EMAIL=admin@example.com

# PostgreSQL Metadata for Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PORT=5433

# =============================================================================
# Kafka & Debezium Configuration
# =============================================================================
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_UI_PORT=8085

DEBEZIUM_PORT=8083
DEBEZIUM_UI_PORT=8084

# =============================================================================
# ClickHouse (OLAP) Configuration
# =============================================================================
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000

# =============================================================================
# Metabase (BI) Configuration
# =============================================================================
METABASE_PORT=3000

# PostgreSQL Metadata for Metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=metabase
METABASE_DB_NAME=metabase
METABASE_DB_PORT=5434
